<UserControl x:Class="SensorFusion.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F6F7">

    <UserControl.Resources>
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>

                            <TextBlock Text="{TemplateBinding Tag}" 
                                       Margin="10,0,0,0" 
                                       VerticalAlignment="Center" 
                                       Foreground="LightGray" 
                                       IsHitTestVisible="False" 
                                       x:Name="watermark" 
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#0078D4"/>
                                <Setter Property="BorderThickness" TargetName="border" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="White" Width="350" Height="420" CornerRadius="15"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#CCCCCC" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel Margin="30">
                <TextBlock Text="📡 Connection Setup" FontSize="24" FontWeight="Bold" 
                           Foreground="#333" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Label Content="Server Address (Linux IP)" Foreground="#666" Margin="0,5,0,0"/>
                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="e.g. 192.168.0.100" 
                         Style="{StaticResource PlaceholderTextBoxStyle}"/>

                <Label Content="Port Number" Foreground="#666" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="e.g. 8080" 
                         Style="{StaticResource PlaceholderTextBoxStyle}"/>

                <CheckBox IsChecked="{Binding IsSimulationMode}" 
                          Content="Use Simulation (Dummy) Mode" 
                          VerticalContentAlignment="Center" Margin="0,10"/>

                <Button Content="ESTABLISH CONNECTION" 
                        Command="{Binding ConnectCommand}"
                        Height="45" Margin="0,20,0,0"
                        Background="#0078D4" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="{Binding ConnectionStatus}" HorizontalAlignment="Center" 
                           Foreground="DodgerBlue" Margin="0,15,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>